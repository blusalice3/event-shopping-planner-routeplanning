{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:continuous-production-probe-source:v2",
  "title": "Continuous production probe authority source v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sourceKind": {
      "const": "continuous-production-probe-source/v2"
    },
    "authorityBundle": {
      "$ref": "#/$defs/evidenceRef"
    },
    "sampleChainHead": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/evidenceRef"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sourceKind",
    "authorityBundle",
    "sampleChainHead"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    }
  }
}
