{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:provider-observation:v1",
  "title": "VercelProviderObservation v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceKind",
    "provider",
    "observedAt",
    "providerTeamId",
    "providerProjectId",
    "ownedProductionDomains",
    "presentEnvironmentNames",
    "wafRules",
    "logPolicy",
    "hsts",
    "evidenceReceipts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "vercel-provider-observation-v1"
    },
    "provider": {
      "const": "vercel"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "providerTeamId": {
      "type": "string",
      "minLength": 1
    },
    "providerProjectId": {
      "type": "string",
      "minLength": 1
    },
    "ownedProductionDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentEnvironmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wafRules": {
      "type": "object"
    },
    "logPolicy": {
      "type": "object"
    },
    "hsts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "maxAgeSeconds",
          "includeSubDomains",
          "preload",
          "headerSha256"
        ]
      }
    },
    "evidenceReceipts": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "method",
          "requestUrl",
          "status",
          "responseDate",
          "etag",
          "bodySha256",
          "responseSha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": ["GET", "HEAD"]
          },
          "requestUrl": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 399
          },
          "responseDate": {
            "type": "string",
            "minLength": 1
          },
          "etag": {
            "type": ["string", "null"]
          },
          "bodySha256": {
            "$ref": "#/$defs/sha256"
          },
          "responseSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
