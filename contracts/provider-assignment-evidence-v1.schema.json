{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:provider-assignment-evidence:v1",
  "title": "ProviderAssignmentEvidence v1",
  "oneOf": [
    {
      "$ref": "#/$defs/assignmentReceipt"
    },
    {
      "$ref": "#/$defs/assignmentValidation"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productionDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "previousDeploymentId": {
          "type": ["string", "null"]
        },
        "assignedDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "productionDomain",
        "previousDeploymentId",
        "assignedDeploymentId"
      ]
    },
    "assignmentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "assignment-receipt"
        },
        "providerProjectId": {
          "type": "string",
          "minLength": 1
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "assignmentApiReceiptSetHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schemaVersion",
        "evidenceKind",
        "providerProjectId",
        "assignments",
        "assignmentApiReceiptSetHash"
      ]
    },
    "assignmentValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "assignment-validation"
        },
        "providerProjectId": {
          "type": "string",
          "minLength": 1
        },
        "assignmentReceiptUri": {
          "type": "string",
          "minLength": 1
        },
        "assignmentReceiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "productionProbeEvidenceHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schemaVersion",
        "evidenceKind",
        "providerProjectId",
        "assignmentReceiptUri",
        "assignmentReceiptSha256",
        "assignments",
        "productionProbeEvidenceHash"
      ]
    }
  }
}
