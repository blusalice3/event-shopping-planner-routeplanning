{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:production-assignment-probe:v1",
  "title": "ProductionAssignmentProbe v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "production-assignment-probe/v1"
    },
    "providerProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "providerDeploymentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "providerDeploymentEvidenceHash": {
      "$ref": "#/$defs/sha256"
    },
    "immutableRouteProbeEvidenceHash": {
      "$ref": "#/$defs/sha256"
    },
    "providerAssignmentObservation": {
      "$ref": "#/$defs/immutableReference"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "immutableApiReceipts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/httpReceipt"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productionDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "providerDeploymentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "status": {
            "const": "PASS"
          },
          "responseSha256": {
            "$ref": "#/$defs/sha256"
          },
          "receipts": {
            "type": "array",
            "minItems": 5,
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/httpReceipt"
            }
          }
        },
        "required": [
          "productionDomain",
          "providerDeploymentId",
          "status",
          "responseSha256",
          "receipts"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "evidenceKind",
    "providerProjectId",
    "providerDeploymentId",
    "providerDeploymentEvidenceHash",
    "immutableRouteProbeEvidenceHash",
    "providerAssignmentObservation",
    "observedAt",
    "immutableApiReceipts",
    "results"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "immutableReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9._-]{0,127}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "nullableHeader": {
      "type": ["string", "null"],
      "maxLength": 8192
    },
    "securityHeaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content-security-policy": {
          "$ref": "#/$defs/nullableHeader"
        },
        "permissions-policy": {
          "$ref": "#/$defs/nullableHeader"
        },
        "referrer-policy": {
          "$ref": "#/$defs/nullableHeader"
        },
        "strict-transport-security": {
          "$ref": "#/$defs/nullableHeader"
        },
        "x-content-type-options": {
          "$ref": "#/$defs/nullableHeader"
        },
        "x-frame-options": {
          "$ref": "#/$defs/nullableHeader"
        }
      },
      "required": [
        "content-security-policy",
        "permissions-policy",
        "referrer-policy",
        "strict-transport-security",
        "x-content-type-options",
        "x-frame-options"
      ]
    },
    "httpReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "GET"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "requestUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "responseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "responseDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "etag": {
          "$ref": "#/$defs/nullableHeader"
        },
        "contentType": {
          "$ref": "#/$defs/nullableHeader"
        },
        "cacheControl": {
          "$ref": "#/$defs/nullableHeader"
        },
        "allow": {
          "$ref": "#/$defs/nullableHeader"
        },
        "securityHeaders": {
          "$ref": "#/$defs/securityHeaders"
        },
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        }
      },
      "required": [
        "method",
        "path",
        "requestUrl",
        "responseUrl",
        "status",
        "responseDate",
        "etag",
        "contentType",
        "cacheControl",
        "allow",
        "securityHeaders",
        "bodySha256",
        "byteLength"
      ]
    }
  }
}
