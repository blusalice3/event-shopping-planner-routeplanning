{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:release-package-index:v1",
  "title": "ReleasePackageIndex v1",
  "oneOf": [
    {
      "$ref": "#/$defs/sourceHardenedPair"
    },
    {
      "$ref": "#/$defs/legacyBootstrapSingle"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releasePhaseGate": {
      "enum": [
        "P0-RELEASE",
        "P1-PWA",
        "P2A-LOCAL",
        "P2B-REPORT",
        "P3-XLSX",
        "P4-CSP",
        "P5-DUAL",
        "P5-LIST",
        "P6-APP",
        "P7-IDB",
        "P8-CLEAN"
      ]
    },
    "policyActivationGate": {
      "enum": [
        "P1-PWA",
        "P2A-LOCAL",
        "P2B-REPORT",
        "P3-XLSX",
        "P4-CSP",
        "P5-DUAL",
        "P5-LIST",
        "P7-IDB"
      ]
    },
    "releaseStateEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "immutableRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "dbCompatibilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contractUri": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["contractUri", "fingerprint"]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "releaseRole": {
          "enum": ["standard", "containment"]
        },
        "variantId": {
          "$ref": "#/$defs/sha256"
        },
        "manifest": {
          "$ref": "#/$defs/immutableRef"
        },
        "archive": {
          "$ref": "#/$defs/immutableRef"
        }
      },
      "required": ["releaseRole", "variantId", "manifest", "archive"]
    },
    "commonProperties": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceSha": {
          "$ref": "#/$defs/sourceSha"
        },
        "buildId": {
          "$ref": "#/$defs/sourceSha"
        },
        "buildAuthority": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/releaseStateEvidenceRef"
            }
          ]
        },
        "targetGate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/releasePhaseGate"
            }
          ]
        },
        "buildPurpose": {
          "enum": [
            "production",
            "non-promotable-policy-activation-qa",
            "legacy-bootstrap"
          ]
        },
        "promotable": {
          "type": "boolean"
        },
        "toolchainPolicyHash": {
          "$ref": "#/$defs/sha256"
        },
        "providerConfigurationHash": {
          "$ref": "#/$defs/sha256"
        },
        "providerPolicyHash": {
          "$ref": "#/$defs/sha256"
        },
        "releasePolicyHash": {
          "$ref": "#/$defs/sha256"
        },
        "requiredDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        }
      },
      "required": [
        "schemaVersion",
        "sourceSha",
        "buildId",
        "buildAuthority",
        "targetGate",
        "buildPurpose",
        "promotable",
        "toolchainPolicyHash",
        "providerConfigurationHash",
        "providerPolicyHash",
        "releasePolicyHash",
        "requiredDbCompatibility"
      ]
    },
    "sourceHardenedPair": {
      "allOf": [
        {
          "$ref": "#/$defs/commonProperties"
        },
        {
          "type": "object",
          "properties": {
            "packageKind": {
              "const": "source-hardened-pair"
            },
            "buildAuthority": {
              "$ref": "#/$defs/releaseStateEvidenceRef"
            },
            "targetGate": {
              "$ref": "#/$defs/releasePhaseGate"
            },
            "artifacts": {
              "type": "array",
              "prefixItems": [
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifactRef"
                    },
                    {
                      "properties": {
                        "releaseRole": {
                          "const": "standard"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifactRef"
                    },
                    {
                      "properties": {
                        "releaseRole": {
                          "const": "containment"
                        }
                      }
                    }
                  ]
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "packageKind",
            "buildAuthority",
            "targetGate",
            "artifacts"
          ],
          "oneOf": [
            {
              "properties": {
                "buildPurpose": {
                  "const": "production"
                },
                "promotable": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "buildPurpose": {
                  "const": "non-promotable-policy-activation-qa"
                },
                "targetGate": {
                  "$ref": "#/$defs/policyActivationGate"
                },
                "promotable": {
                  "const": false
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "legacyBootstrapSingle": {
      "allOf": [
        {
          "$ref": "#/$defs/commonProperties"
        },
        {
          "type": "object",
          "properties": {
            "packageKind": {
              "const": "legacy-bootstrap-single"
            },
            "buildAuthority": {
              "type": "null"
            },
            "targetGate": {
              "type": "null"
            },
            "buildPurpose": {
              "const": "legacy-bootstrap"
            },
            "promotable": {
              "const": false
            },
            "bootstrapInput": {
              "$ref": "#/$defs/immutableRef"
            },
            "rawDistManifest": {
              "$ref": "#/$defs/immutableRef"
            },
            "artifact": {
              "allOf": [
                {
                  "$ref": "#/$defs/artifactRef"
                },
                {
                  "properties": {
                    "releaseRole": {
                      "const": "containment"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "packageKind",
            "buildAuthority",
            "targetGate",
            "buildPurpose",
            "promotable",
            "bootstrapInput",
            "rawDistManifest",
            "artifact"
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
