{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:continuous-production-probe-source:v1",
  "title": "Continuous production probe source v1",
  "x-foundation-lifecycle": "migration-only",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceKind": {
      "const": "continuous-production-probe-source/v1"
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "required": ["schemaVersion", "sourceKind", "samples"],
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "required": ["observedAt", "results"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productionDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "providerDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "status": {
          "const": "PASS"
        },
        "responseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "productionDomain",
        "providerDeploymentId",
        "status",
        "responseSha256"
      ]
    }
  }
}
