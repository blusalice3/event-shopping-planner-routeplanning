{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:companion-recovery-drill-source:v2",
  "title": "Companion recovery drill authority source v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sourceKind": {
      "const": "companion-recovery-drill-source/v2"
    },
    "authorityBundle": {
      "$ref": "#/$defs/evidenceRef"
    },
    "packageRedeployTerminalEvent": {
      "$ref": "#/$defs/eventRef"
    },
    "standardReturnEvent": {
      "$ref": "#/$defs/eventRef"
    }
  },
  "required": [
    "schemaVersion",
    "sourceKind",
    "authorityBundle",
    "packageRedeployTerminalEvent",
    "standardReturnEvent"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/events/[1-9][0-9]*/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    }
  }
}
