{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:continuous-production-probe:v1",
  "title": "Continuous production probe authority evidence v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "continuous-production-probe/v1" },
    "namespace": { "$ref": "#/$defs/namespace" },
    "operationId": { "$ref": "#/$defs/identifier" },
    "sourceSha": { "$ref": "#/$defs/sourceSha" },
    "buildId": { "$ref": "#/$defs/sourceSha" },
    "standardBindingId": { "$ref": "#/$defs/identifier" },
    "providerProjectId": { "$ref": "#/$defs/identifier" },
    "providerDeploymentId": { "$ref": "#/$defs/identifier" },
    "assignmentValidationEvidence": { "$ref": "#/$defs/evidenceRef" },
    "observationStartedEvent": { "$ref": "#/$defs/eventRef" },
    "releaseAEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "releaseAEvidenceAuthority": { "$ref": "#/$defs/evidenceRef" },
    "sourceEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "sourceWorkflowAuthority": { "$ref": "#/$defs/evidenceRef" },
    "maximumGapSeconds": { "const": 300 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "sampleCount": { "type": "integer", "minimum": 2 },
    "ownedProductionDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "required": [
    "schemaVersion",
    "evidenceKind",
    "namespace",
    "operationId",
    "sourceSha",
    "buildId",
    "standardBindingId",
    "providerProjectId",
    "providerDeploymentId",
    "assignmentValidationEvidence",
    "observationStartedEvent",
    "releaseAEvidenceSha256",
    "releaseAEvidenceAuthority",
    "sourceEvidenceSha256",
    "sourceWorkflowAuthority",
    "maximumGapSeconds",
    "startedAt",
    "endedAt",
    "sampleCount",
    "ownedProductionDomains",
    "samples"
  ],
  "$defs": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["uri", "sha256"]
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/events/[1-9][0-9]*/[0-9a-f]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["uri", "sha256"]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "sampleEvidence": { "$ref": "#/$defs/evidenceRef" },
        "sampleChainCommit": { "$ref": "#/$defs/evidenceRef" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result" }
        }
      },
      "required": [
        "observedAt",
        "sampleEvidence",
        "sampleChainCommit",
        "results"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productionDomain": { "$ref": "#/$defs/domain" },
        "providerDeploymentId": { "$ref": "#/$defs/identifier" },
        "status": { "const": "PASS" },
        "responseSha256": { "$ref": "#/$defs/sha256" },
        "httpReceipt": { "$ref": "#/$defs/evidenceRef" },
        "providerLookupReceipt": { "$ref": "#/$defs/evidenceRef" }
      },
      "required": [
        "productionDomain",
        "providerDeploymentId",
        "status",
        "responseSha256",
        "httpReceipt",
        "providerLookupReceipt"
      ]
    }
  }
}
