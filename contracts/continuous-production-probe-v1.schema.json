{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:continuous-production-probe:v1",
  "title": "Continuous production probe v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "continuous-production-probe/v1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "standardBindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "providerProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "providerDeploymentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "assignmentValidationEvidence": {
      "$ref": "#/$defs/evidenceRef"
    },
    "observationStartedEvent": {
      "$ref": "#/$defs/eventRef"
    },
    "releaseAEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "maximumGapSeconds": {
      "const": 300
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 2
    },
    "ownedProductionDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "urn:event-shopping-planner:continuous-production-probe-source:v1#/$defs/sample"
      }
    }
  },
  "required": [
    "schemaVersion",
    "evidenceKind",
    "namespace",
    "operationId",
    "sourceSha",
    "buildId",
    "standardBindingId",
    "providerProjectId",
    "providerDeploymentId",
    "assignmentValidationEvidence",
    "observationStartedEvent",
    "releaseAEvidenceSha256",
    "sourceEvidenceSha256",
    "maximumGapSeconds",
    "startedAt",
    "endedAt",
    "sampleCount",
    "ownedProductionDomains",
    "samples"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/events/[1-9][0-9]*/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    }
  }
}
