{
  "schemaVersion": 1,
  "scenarioId": "list-virtual-focus-interaction",
  "domain": "shopping-list",
  "dataset": {
    "generator": "shopping-list-seeded-v1",
    "seed": 1967,
    "rowCount": 10000,
    "grouped": false
  },
  "viewport": {
    "columnCount": 1,
    "zoomPercent": 100
  },
  "operation": {
    "rendererPreference": "auto",
    "interaction": "keyboard-focus-restore",
    "targetRowIndex": 5000,
    "iterationCount": 50
  },
  "requiredAssertions": [
    "selected-renderer-virtual",
    "focused-row-pinned",
    "focus-restored-by-row-key",
    "accessible-name-parity"
  ],
  "requiredTelemetry": [
    "durationMs",
    "maxMainThreadTaskMs",
    "focusRestoreFailureCount"
  ]
}
