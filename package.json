{
  "name": "event-shopping-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode release-a",
    "build:release-a": "npm run build && node scripts/verify-release-a-build.mjs",
    "test:release-a-browser": "node scripts/verify-release-a-browser.mjs",
    "test:release-a-evidence": "node --test scripts/verify-release-a-evidence.test.mjs",
    "test:release-a-rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearse-release-a-rollback.ps1",
    "test:encoding": "node scripts/verify-encoding.mjs",
    "verify:release-a-evidence": "node scripts/verify-release-a-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "generate-icons": "pwa-assets-generator",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"api/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"api/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.1.8",
    "workbox-window": "^7.1.0",
    "ws": "^8.20.0"
  }
}
