{
  "name": "event-shopping-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:release-a",
    "build:app": "tsc --noEmit && node scripts/build-release-vite.mjs",
    "build:containment": "tsc --noEmit && node scripts/build-release-vite.mjs --role containment",
    "build:qa:xlsx-main": "node scripts/build-release-vite.mjs --qa-profile xlsx-main && node scripts/verify-release-a-build.mjs --allow-nonpromotable-qa",
    "build:qa:list-force-full": "node scripts/build-release-vite.mjs --qa-profile list-force-full && node scripts/verify-release-a-build.mjs --allow-nonpromotable-qa",
    "build:release-a": "npm run build:app && node scripts/verify-release-a-build.mjs",
    "artifact:build": "node scripts/build-release-artifact.mjs",
    "artifact:verify": "node scripts/verify-release-artifact.mjs",
    "quality": "npm run test:encoding && npm run format:check && npm run verify:baseline && npm run verify:foundation && npm run verify:toolchain && npm run verify:dependency-usage && npm run test:dependency-usage && npm run verify:audit && npm run verify:db-compatibility && npm run verify:provider-policy && npm run verify:csp-policy && npm run verify:metrics-contract && npm run verify:metrics-retention && npm run verify:performance-policy && npm run typecheck && npm run lint && npm run verify:test-project-membership && npm run verify:architecture && npm run verify:coverage-policy && npm run test:coverage-policy && npm run test:foundation && npm run test:unit && npm run test:integration && npm run test:worker && npm run test:api && npm run test:coverage",
    "quality:local": "npm run test:encoding && npm run format:check && npm run verify:baseline && npm run verify:foundation && npm run verify:toolchain:policy && npm run verify:dependency-usage && npm run test:dependency-usage && npm run verify:audit && npm run verify:db-compatibility && npm run verify:provider-policy && npm run verify:csp-policy && npm run verify:metrics-contract && npm run verify:metrics-retention && npm run verify:performance-policy && npm run typecheck && npm run lint && npm run verify:test-project-membership && npm run verify:architecture && npm run verify:coverage-policy && npm run test:coverage-policy && npm run test:foundation && npm run test:unit && npm run test:integration && npm run test:worker && npm run test:api",
    "test:foundation": "node --test scripts/build-pwa-recovery-agent.test.mjs scripts/canonical-json.test.mjs scripts/deterministic-zip.test.mjs scripts/foundation-control-verifiers.test.mjs scripts/performance-policy.test.mjs scripts/provider/collect-vercel-observation.test.mjs scripts/provider/deploymentBindingProducer.test.mjs scripts/provider/prebuiltDeployment.test.mjs scripts/provider/preparedPromotion.test.mjs scripts/provider/produce-deployment-binding.test.mjs scripts/provider/produce-production-assignment-validation.test.mjs scripts/provider/productionAssignmentValidation.test.mjs scripts/provider/providerConfiguration.test.mjs scripts/release-artifact.test.mjs scripts/release-policy.test.mjs scripts/release-state/acceptanceEvidenceInputProducerCli.test.mjs scripts/release-state/acceptanceEvidenceInputs.test.mjs scripts/release-state/authoritativeInputProducerCli.test.mjs scripts/release-state/authoritativeInputProducers.test.mjs scripts/release-state/executeReleaseLifecycleCli.test.mjs scripts/release-state/lifecycleExecution.test.mjs scripts/release-state/protectedReleaseCli.test.mjs scripts/release-state/protectedWorkflowCore.test.mjs scripts/release-state/releaseStateAdapters.test.mjs scripts/release-state/releaseStateReducer.test.mjs scripts/verify-release-a-browser.test.mjs scripts/verify-release-a-evidence-bundle.test.mjs scripts/verify-release-a-evidence.test.mjs",
    "test:artifact": "node --test scripts/deterministic-zip.test.mjs scripts/release-artifact.test.mjs",
    "test:release-state": "node --test scripts/release-state/acceptanceEvidenceInputProducerCli.test.mjs scripts/release-state/acceptanceEvidenceInputs.test.mjs scripts/release-state/authoritativeInputProducerCli.test.mjs scripts/release-state/authoritativeInputProducers.test.mjs scripts/release-state/executeReleaseLifecycleCli.test.mjs scripts/release-state/lifecycleExecution.test.mjs scripts/release-state/protectedReleaseCli.test.mjs scripts/release-state/protectedWorkflowCore.test.mjs scripts/release-state/releaseStateAdapters.test.mjs scripts/release-state/releaseStateReducer.test.mjs",
    "test:release-a-browser": "node scripts/verify-release-a-browser.mjs",
    "test:release-a-evidence": "node --test scripts/verify-release-a-evidence.test.mjs",
    "test:release-a-rollback": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/rehearse-release-a-rollback.ps1",
    "test:encoding": "node scripts/verify-encoding.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:worker": "vitest run --project worker --passWithNoTests",
    "test:api": "node --test api/csp-report.test.mjs api/google-sheets-csv.test.mjs api/not-found.test.mjs",
    "test:coverage-policy": "node --test scripts/coverage-policy/coverage-policy.test.mjs",
    "test:coverage": "node scripts/coverage-policy/run-coverage-policy.mjs",
    "test:dependency-usage": "node --test scripts/verify-direct-dependency-usage.test.mjs",
    "test:db:disposable": "node scripts/test-disposable-db.mjs",
    "test:provider": "node --test scripts/provider/collect-vercel-observation.test.mjs scripts/provider/deploymentBindingProducer.test.mjs scripts/provider/prebuiltDeployment.test.mjs scripts/provider/preparedPromotion.test.mjs scripts/provider/produce-deployment-binding.test.mjs scripts/provider/produce-production-assignment-validation.test.mjs scripts/provider/productionAssignmentValidation.test.mjs scripts/provider/providerConfiguration.test.mjs",
    "test:browser": "npm run build:release-a && playwright test",
    "test:a11y": "npm run build:release-a && playwright test --grep @a11y",
    "test:qa-builds": "npm run build:qa:xlsx-main && npm run build:qa:list-force-full",
    "verify:artifact": "npm run test:artifact",
    "verify:foundation": "node scripts/verify-foundation-policy.mjs",
    "verify:db-compatibility": "node scripts/verify-db-compatibility-contract.mjs",
    "verify:provider-policy": "node scripts/provider/verify-provider-policy.mjs",
    "provider:observe": "node scripts/provider/collect-vercel-observation.mjs",
    "provider:validate-production-assignment": "node scripts/provider/produce-production-assignment-validation.mjs",
    "verify:csp-policy": "node scripts/verify-csp-policy.mjs",
    "verify:metrics-contract": "node scripts/verify-metrics-contract.mjs",
    "verify:metrics-retention": "node scripts/verify-metrics-retention.mjs",
    "verify:performance-policy": "node scripts/verify-performance-policy.mjs",
    "verify:release-state": "node scripts/verify-release-state.mjs",
    "release:produce-input": "node scripts/release-state/produce-protected-input.mjs",
    "release:protected": "node scripts/release-state/protected-release.mjs",
    "release:lifecycle": "node scripts/release-state/execute-release-lifecycle.mjs",
    "release:acceptance-input": "node scripts/release-state/produce-acceptance-evidence-input.mjs",
    "release:deploy-prebuilt": "node scripts/provider/deploy-prebuilt.mjs",
    "release:produce-deployment-binding": "node scripts/provider/produce-deployment-binding.mjs",
    "release:promote-prepared": "node scripts/provider/promote-prepared.mjs",
    "verify:release-a-evidence-bundle": "node scripts/verify-release-a-evidence-bundle.mjs",
    "verify:release-a-evidence": "node scripts/verify-release-a-evidence.mjs",
    "verify:baseline": "node scripts/verify-foundation-baseline.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:toolchain:policy": "node scripts/verify-toolchain.mjs --allow-runtime-mismatch",
    "verify:dependency-usage": "node scripts/verify-direct-dependency-usage.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:test-project-membership": "node scripts/verify-test-project-membership.mjs",
    "verify:coverage-policy": "node scripts/verify-coverage-policy.mjs",
    "verify:audit": "node scripts/verify-audit.mjs",
    "baseline:foundation:update": "node scripts/verify-foundation-baseline.mjs --write-baseline",
    "baseline:architecture:update": "node scripts/verify-architecture.mjs --write-baseline",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.release-tools.json",
    "preview": "vite preview",
    "generate-icons": "pwa-assets-generator",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml}\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.9",
    "@zip.js/zip.js": "2.8.34",
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "axe-core": "4.12.1",
    "canonicalize": "3.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "pg": "8.22.0",
    "postcss": "8.5.25",
    "prettier": "3.8.1",
    "supabase": "2.111.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vercel": "58.5.1",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "minimatch@10.1.1": "10.2.6",
    "path-to-regexp@6.1.0": "6.3.0",
    "path-to-regexp@8.2.0": "8.4.2",
    "path-to-regexp@8.3.0": "8.4.2",
    "sharp": "0.35.3",
    "smol-toml": "1.7.1",
    "tar": "7.5.22",
    "undici@5.28.4": "6.28.0",
    "undici@5.29.0": "6.28.0",
    "undici@^6.23.0": "6.28.0",
    "undici@^7.27.1": "7.29.0",
    "uuid@^8.3.0": "11.1.1"
  }
}
