{
  "name": "event-shopping-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sharing:public-guard:check && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:connect:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-real-supabase.ps1",
    "db:auth:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-supabase-auth-settings.ps1",
    "db:pull": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pull-database-baseline.ps1",
    "db:reset": "supabase db reset",
    "db:typegen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-database-types.ps1",
    "db:typegen:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-database-types.ps1 -Local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "encoding:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-utf8.ps1",
    "sharing:public-guard:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-sharing-public-guard.ps1",
    "sharing:public-guard:unit": "vitest run src/features/sharing/publicGuardClient.test.ts src/features/sharing/publicGuardEdgeCanonical.test.ts src/features/sharing/clientPublicGuard.test.ts src/features/sharing/SharingMvp0cPanel.test.tsx",
    "generate-icons": "pwa-assets-generator",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "exceljs": "^4.4.0",
    "json-canonicalize": "^2.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "supabase": "^2.106.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.1.8",
    "workbox-window": "^7.1.0"
  }
}
