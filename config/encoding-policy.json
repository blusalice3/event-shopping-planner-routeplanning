{
  "schemaVersion": 1,
  "encoding": "utf-8",
  "bom": "forbidden",
  "defaultEol": "lf",
  "scanRoots": [
    ".github",
    "api",
    "config",
    "contracts",
    "docs",
    "ops",
    "public",
    "scripts",
    "src",
    "supabase"
  ],
  "rootFiles": [
    ".gitattributes",
    ".gitignore",
    ".prettierrc.json",
    "AGENTS.md",
    "README.md",
    "eslint.config.js",
    "index.html",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "postcss.config.cjs",
    "pwa-assets.config.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.release-tools.json",
    "tsconfig.worker.json",
    "tailwind.config.cjs",
    "vercel.json",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.unit.config.ts",
    "vitest.worker.config.ts"
  ],
  "textExtensions": [
    ".cjs",
    ".css",
    ".cts",
    ".html",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".mjs",
    ".mts",
    ".ps1",
    ".sql",
    ".svg",
    ".ts",
    ".tsx",
    ".txt",
    ".toml",
    ".yml",
    ".yaml"
  ],
  "eolExceptions": {
    "AGENTS.md": "crlf",
    "docs/Event Shopping Planner — Scoped Reliability & Data Integrity Remediation Plan.txt": "crlf",
    "docs/Resilient Persistence & Safe Migration Plan.md": "crlf"
  },
  "requiredRepresentativeStrings": ["ユーザー登録", "エラーが発生しました"],
  "suspiciousQuestionMarkPattern": "(?:[ぁ-んァ-ヶ一-龠々〆ヵヶ]\\?[ぁ-んァ-ヶ一-龠々〆ヵヶ]|\\?{3,})",
  "suspiciousMojibakePattern": "(?:繧[ァ-ヶ]|繝[ァ-ヶ]|縺[ぁ-ん]|譁\\uFFFD|陦\\uFFFD|蜿\\uFFFD|隱\\uFFFD|髫\\uFFFD)"
}
