{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-shopping-planner.invalid/schemas/own-gate-performance-evidence-v1.json",
  "title": "Authoritative own-gate performance evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidence",
    "evidenceSha256",
    "producerReceipt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidence": {
      "$ref": "https://event-shopping-planner.invalid/schemas/performance-evidence-v1.json#/properties/evidence"
    },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "producerReceipt": { "$ref": "#/$defs/producerReceipt" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "uri"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        }
      }
    },
    "producerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "receipt", "receiptSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receipt": { "$ref": "#/$defs/producerReceiptBody" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producerReceiptBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "namespace",
        "operationId",
        "acceptedGate",
        "performanceGate",
        "source",
        "authoritativeState",
        "requirementsSha256",
        "artifactArchiveSha256",
        "rawSamplesArtifact",
        "producerRunId",
        "producerRunAttempt",
        "performanceEvidence",
        "producedAtUtc"
      ],
      "properties": {
        "kind": {
          "const": "own-gate-performance-evidence-producer-receipt/v1"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "acceptedGate": {
          "enum": ["P0-RELEASE", "P3-XLSX", "P5-DUAL", "P5-LIST"]
        },
        "performanceGate": {
          "enum": ["P0-TOOLCHAIN", "P3-XLSX", "P5-DUAL", "P5-LIST"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gitCommitSha", "sourceClosureSha256", "treeState"],
          "properties": {
            "gitCommitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sourceClosureSha256": { "$ref": "#/$defs/sha256" },
            "treeState": { "const": "clean" }
          }
        },
        "authoritativeState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "eventHash"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 },
            "eventHash": { "$ref": "#/$defs/sha256" }
          }
        },
        "requirementsSha256": { "$ref": "#/$defs/sha256" },
        "artifactArchiveSha256": { "$ref": "#/$defs/sha256" },
        "rawSamplesArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "runId",
            "runAttempt",
            "sha256",
            "collectorIdentity",
            "workflowRunAuthority"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^foundation-performance-raw-samples-[0-9a-f]{40}-[1-9][0-9]{0,9}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "runAttempt": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$"
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "collectorIdentity": { "$ref": "#/$defs/evidenceRef" },
            "workflowRunAuthority": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "producerRunId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "producerRunAttempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "performanceEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "envelopeSha256", "evidenceSha256"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^foundation-performance-own-gate-evidence-[0-9a-f]{40}-[1-9][0-9]{0,9}$"
            },
            "envelopeSha256": { "$ref": "#/$defs/sha256" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "producedAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
