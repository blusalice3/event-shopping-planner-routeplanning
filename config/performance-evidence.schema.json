{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-shopping-planner.invalid/schemas/performance-evidence-v1.json",
  "title": "Web foundation performance evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidence", "evidenceSha256"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "gate",
        "collectedAtUtc",
        "policyBindings",
        "source",
        "environment",
        "sampleCount",
        "statisticsMethod",
        "scenarios"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^perf-[a-z0-9][a-z0-9._-]{7,127}$"
        },
        "gate": {
          "enum": ["P0-TOOLCHAIN", "P3-XLSX", "P5-DUAL", "P5-LIST", "P8-CLEAN"]
        },
        "collectedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "policyBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uiScenariosSha256",
            "performanceBudgetContractSha256",
            "xlsxLimitsSha256"
          ],
          "properties": {
            "uiScenariosSha256": {
              "$ref": "#/$defs/sha256"
            },
            "performanceBudgetContractSha256": {
              "$ref": "#/$defs/sha256"
            },
            "xlsxLimitsSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gitCommitSha",
            "sourceClosureSha256",
            "treeState",
            "artifactSha256",
            "releaseVariant"
          ],
          "properties": {
            "gitCommitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sourceClosureSha256": {
              "$ref": "#/$defs/sha256"
            },
            "treeState": {
              "const": "clean"
            },
            "artifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "releaseVariant": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "releaseRole",
                "xlsxExecution",
                "listEngine",
                "listDefault"
              ],
              "properties": {
                "releaseRole": {
                  "const": "standard"
                },
                "xlsxExecution": {
                  "enum": ["main", "worker"]
                },
                "listEngine": {
                  "enum": ["full", "dual"]
                },
                "listDefault": {
                  "enum": ["full", "auto"]
                }
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machineProfile", "browser"],
          "properties": {
            "machineProfile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "cpu", "memoryBytes", "powerMode"],
              "properties": {
                "os": {
                  "type": "string",
                  "minLength": 1
                },
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "powerMode": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "browser": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "version", "channel"],
              "properties": {
                "family": {
                  "const": "chromium"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
                },
                "channel": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "sampleCount": {
          "const": 30
        },
        "statisticsMethod": {
          "const": "median-average-p95-nearest-rank-v1"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenarioEvidence"
          }
        }
      }
    },
    "evidenceSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p95", "maximum"],
      "properties": {
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "supplementaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "samples", "samplesSha256", "statistics"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,63}$"
        },
        "samples": {
          "$ref": "#/$defs/samples"
        },
        "samplesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "statistics": {
          "$ref": "#/$defs/statistics"
        }
      }
    },
    "scenarioEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixtureSha256",
        "primaryMetric",
        "samples",
        "samplesSha256",
        "statistics",
        "supplementaryMetrics",
        "outcomeAssertions",
        "executionBinding"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "fixtureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "primaryMetric": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,63}$"
        },
        "samples": {
          "$ref": "#/$defs/samples"
        },
        "samplesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "statistics": {
          "$ref": "#/$defs/statistics"
        },
        "supplementaryMetrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supplementaryMetric"
          }
        },
        "outcomeAssertions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "const": true
          }
        },
        "executionBinding": {
          "$ref": "#/$defs/executionBinding"
        }
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterContract",
        "fixturePayload",
        "faultInjection",
        "setup"
      ],
      "properties": {
        "adapterContract": {
          "const": "public-artifact-surface-v1"
        },
        "fixturePayload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "seed",
            "cardinality",
            "payloadSha256",
            "semanticSha256"
          ],
          "properties": {
            "generator": { "type": "string", "minLength": 1 },
            "seed": { "type": ["integer", "null"], "minimum": 0 },
            "cardinality": { "type": ["integer", "null"], "minimum": 0 },
            "payloadSha256": { "$ref": "#/$defs/sha256" },
            "semanticSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "faultInjection": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "originalWorkerSha256",
                "replacementWorkerSha256"
              ],
              "properties": {
                "method": {
                  "const": "playwright-exact-worker-response-substitution-v1"
                },
                "originalWorkerSha256": { "$ref": "#/$defs/sha256" },
                "replacementWorkerSha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "setup": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "timing",
                "readback",
                "databaseName",
                "databaseVersion",
                "storeName",
                "controlStoreName",
                "key",
                "transactionStores",
                "payloadSha256",
                "semanticSha256",
                "itemCount",
                "revision"
              ],
              "properties": {
                "method": {
                  "const": "indexeddb-schema-exact-single-transaction-stage-v1"
                },
                "timing": { "const": "excluded-from-measurement-v1" },
                "readback": {
                  "const": "separate-readonly-transaction-v1"
                },
                "databaseName": { "const": "EventShoppingPlannerDB" },
                "databaseVersion": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 7
                },
                "storeName": { "const": "eventLists" },
                "controlStoreName": { "const": "syncQueue" },
                "key": { "const": "data" },
                "transactionStores": {
                  "type": "array",
                  "prefixItems": [
                    { "const": "eventLists" },
                    { "const": "syncQueue" }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "payloadSha256": { "$ref": "#/$defs/sha256" },
                "semanticSha256": { "$ref": "#/$defs/sha256" },
                "itemCount": { "const": 50000 },
                "revision": {
                  "type": "string",
                  "pattern": "^performance-stage:[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
