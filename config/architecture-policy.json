{
  "schemaVersion": 1,
  "sourceRoots": ["src"],
  "extensions": [".ts", ".tsx"],
  "contractTestRoots": ["src", "tests", "scripts"],
  "contractTestExtensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"],
  "productionExcludes": [
    "\\.(?:test|spec)\\.(?:ts|tsx)$",
    "\\.d\\.ts$",
    "(?:^|/)test/",
    "_backup\\.tsx?$",
    "\\.backup\\.tsx?$"
  ],
  "layers": [
    {
      "name": "entry",
      "pathRegex": "^src/(?:index\\.tsx|sw\\.ts|pwa/recovery/outerAgentEntry\\.ts)$"
    },
    {
      "name": "pwa",
      "pathRegex": "^src/pwa/"
    },
    {
      "name": "app",
      "pathRegex": "^src/(?:App\\.tsx|app/|features/app-shell/)"
    },
    {
      "name": "ui",
      "pathRegex": "^src/(?:components/|features/.*/components/)"
    },
    {
      "name": "feature",
      "pathRegex": "^src/features/"
    },
    {
      "name": "xlsx",
      "pathRegex": "^src/xlsx/"
    },
    {
      "name": "persistence",
      "pathRegex": "^src/persistence/"
    },
    {
      "name": "hook",
      "pathRegex": "^src/hooks/"
    },
    {
      "name": "utility",
      "pathRegex": "^src/utils/"
    },
    {
      "name": "style",
      "pathRegex": "^src/styles/"
    },
    {
      "name": "library",
      "pathRegex": "^src/lib/"
    },
    {
      "name": "type",
      "pathRegex": "^src/(?:types\\.ts|types/)"
    }
  ],
  "forbiddenImportRules": [
    {
      "id": "production-node-runtime",
      "sourceRegex": "^src/",
      "packageRegex": "^(?:node:|fs$|path$|child_process$|crypto$|net$|os$)"
    },
    {
      "id": "ui-direct-indexeddb",
      "sourceRegex": "^src/(?:App\\.tsx|components/|features/)",
      "targetRegex": "^src/utils/indexedDB\\.ts$"
    },
    {
      "id": "ui-direct-xlsx-package",
      "sourceRegex": "^src/(?:App\\.tsx|components/|features/)",
      "packageRegex": "^(?:exceljs|xlsx)$"
    },
    {
      "id": "ui-direct-xlsx-implementation",
      "sourceRegex": "^src/(?:App\\.tsx|components/|features/)",
      "targetRegex": "^src/xlsx/(?:adapters|download|engine|security|worker)/"
    },
    {
      "id": "ui-direct-persistence-implementation",
      "sourceRegex": "^src/(?:components/|features/)",
      "targetRegex": "^src/persistence/"
    },
    {
      "id": "ui-direct-block-detection-storage",
      "sourceRegex": "^src/(?:components/|features/)",
      "targetRegex": "^src/utils/blockDetectionSettingsStorage\\.ts$"
    },
    {
      "id": "app-direct-xlsx-implementation",
      "sourceRegex": "^src/App\\.tsx$",
      "targetRegex": "^src/xlsx/"
    },
    {
      "id": "app-command-direct-xlsx-implementation",
      "sourceRegex": "^src/app/commands/",
      "targetRegex": "^src/xlsx/(?:adapters|download|engine|security|worker)/"
    },
    {
      "id": "app-direct-persistence-implementation",
      "sourceRegex": "^src/App\\.tsx$",
      "targetRegex": "^src/(?:persistence/|utils/indexedDB\\.ts$)"
    },
    {
      "id": "app-command-direct-persistence-implementation",
      "sourceRegex": "^src/app/commands/",
      "targetRegex": "^src/(?:persistence/|utils/(?:indexedDB|blockDetectionSettingsStorage)\\.ts$)"
    },
    {
      "id": "app-direct-service-worker-implementation",
      "sourceRegex": "^src/(?:App\\.tsx|app/commands/)",
      "targetRegex": "^src/(?:pwa/|sw\\.ts$)"
    },
    {
      "id": "application-ws-runtime",
      "sourceRegex": "^src/",
      "packageRegex": "^ws$"
    },
    {
      "id": "outer-agent-no-package-import",
      "sourceRegex": "^src/pwa/(?:recovery/|releaseIdentityProtocol\\.ts$)",
      "packageRegex": ".+"
    }
  ],
  "requiredDirectImportRules": [
    {
      "id": "app-phase6-composition-boundaries",
      "source": "src/App.tsx",
      "targets": [
        "src/app/commands/useEventLifecycleCommands.ts",
        "src/app/commands/useEventTransferCommands.ts",
        "src/app/commands/useEventUpdateCommands.ts",
        "src/app/commands/useMapEditorCommands.ts",
        "src/app/commands/useMapImportCommands.ts",
        "src/app/commands/useMapRouteCommands.ts",
        "src/app/commands/useMapVisitListCommands.ts",
        "src/app/commands/useShoppingItemMutationCommands.ts",
        "src/app/commands/useShoppingSelectionExecutionCommands.ts",
        "src/app/navigation/navigationSelectors.ts",
        "src/app/selectors/appListViewSelectors.ts",
        "src/app/selectors/appMapViewSelectors.ts",
        "src/app/state/useAppOverlayController.ts",
        "src/features/map/domain/normalizeHydratedHallState.ts"
      ]
    },
    {
      "id": "overlay-layer-grouped-controller-boundary",
      "source": "src/features/app-shell/components/AppOverlayLayer.tsx",
      "targets": [
        "src/app/state/appOverlayState.ts",
        "src/app/state/useAppOverlayController.ts"
      ]
    }
  ],
  "entryGraphRules": [
    {
      "id": "application-entry-no-supabase",
      "entry": "src/index.tsx",
      "forbiddenTargetRegex": "^src/lib/supabase\\.ts$"
    },
    {
      "id": "containment-entry-no-application",
      "entry": "src/pwa/containment/index.ts",
      "forbiddenTargetRegex": "^src/(?:App\\.tsx$|app/|features/app-shell/)"
    },
    {
      "id": "containment-entry-no-persistence",
      "entry": "src/pwa/containment/index.ts",
      "forbiddenTargetRegex": "^src/(?:persistence/|utils/indexedDB\\.ts$|hooks/useIndexedDbPersistence\\.ts$)"
    },
    {
      "id": "containment-entry-no-xlsx",
      "entry": "src/pwa/containment/index.ts",
      "forbiddenTargetRegex": "^src/xlsx/"
    },
    {
      "id": "containment-entry-no-list",
      "entry": "src/pwa/containment/index.ts",
      "forbiddenTargetRegex": "^src/(?:features/shopping-list/|components/(?:ShoppingList|ShoppingItemCard|SummaryBar|VisitListPanel|map/(?:MapVisitListPanel|VisitListPanel))\\.(?:ts|tsx)$)"
    },
    {
      "id": "outer-agent-closed-graph",
      "entry": "src/pwa/recovery/outerAgentEntry.ts",
      "forbiddenTargetRegex": "^(?!src/pwa/(?:recovery/|releaseIdentityProtocol\\.ts$)).+"
    }
  ],
  "forbiddenTextRules": [
    {
      "id": "release-a-no-cleanup-call",
      "sourceRegex": "^src/(?!utils/indexedDB\\.ts$)",
      "pattern": "\\bcleanupLegacyPersistenceSources\\s*\\("
    },
    {
      "id": "app-no-browser-persistence-or-sw-global",
      "sourceRegex": "^src/(?:App\\.tsx|app/(?:commands|state)/)",
      "pattern": "\\b(?:localStorage|sessionStorage|indexedDB|IDBDatabase|IDBTransaction|ServiceWorkerRegistration|skipWaiting|clientsClaim)\\b|\\bnavigator\\s*\\.\\s*serviceWorker\\b"
    },
    {
      "id": "app-ui-state-no-overlay-shadow",
      "sourceRegex": "^src/app/state/useAppUiState\\.ts$",
      "pattern": "\\b(?:editDialogItem|itemToDelete|pendingEventUpdate|showUrlUpdateDialog|pendingUpdateEventName|showRenameDialog|eventToRename|pendingDuplicateEvent|showExportOptions|exportEventName|pendingBackup|pendingXlsxRestoreCompletion|mapImportDialogOpen|mapImportPendingFile|mapImportPendingEventName|pendingMapReimport)\\b"
    },
    {
      "id": "map-workspace-state-no-overlay-shadow",
      "sourceRegex": "^src/app/state/useMapWorkspaceState\\.ts$",
      "pattern": "\\b(?:visitListPanelOpen|visitListPanelMapTab|visitListHasUnsavedChanges|visitListOriginalOrder|showVisitListConfirmDialog|pendingTabChange|blockDefinitionMode|cellSelectionMode|pendingCellSelection|hallDefinitionMode|vertexSelectionMode|pendingVertexSelection|smartInsertToast)\\b"
    },
    {
      "id": "hook-no-direct-persistence-mutation",
      "sourceRegex": "^src/hooks/useIndexedDbPersistence\\.ts$",
      "pattern": "\\bdb\\s*\\.\\s*(?:save[A-Z]|migrateFromLocalStorage|adoptRecoveryCandidate)"
    },
    {
      "id": "ui-no-direct-browser-storage-mutation",
      "sourceRegex": "^src/(?:components/|features/(?!shopping-list/preference/localStorageListRendererPreferenceAdapter\\.ts$))",
      "pattern": "\\b(?:window\\s*\\.\\s*)?localStorage\\s*\\.\\s*(?:getItem|setItem|removeItem|clear)\\s*\\("
    },
    {
      "id": "outer-agent-no-dynamic-nonliteral-import",
      "sourceRegex": "^src/pwa/(?:recovery/|releaseIdentityProtocol\\.ts$)",
      "pattern": "\\bimport\\s*\\(\\s*(?![\"'])"
    },
    {
      "id": "no-legacy-navigation-projection",
      "sourceRegex": "^src/",
      "pattern": "\\b(?:LegacyScreenState|screenStateFromLegacy|screenStateToLegacy)\\b"
    },
    {
      "id": "no-legacy-overlay-projection-consumer",
      "sourceRegex": "^src/",
      "pattern": "\\b(?:LegacyAppOverlay|selectLegacyAppOverlayProjection|migrateLegacyAppOverlayState)\\b"
    },
    {
      "id": "overlay-controller-no-projection-bridge",
      "sourceRegex": "^src/app/state/useAppOverlayController\\.ts$",
      "pattern": "\\bprojection\\b"
    }
  ],
  "forbiddenContractTestTextRules": [
    {
      "id": "no-app-source-text-contract-test",
      "sourceRegex": "\\.(?:test|spec)\\.(?:ts|tsx)$",
      "pattern": "(?:readFileSync|readFile)\\s*\\([\\s\\S]{0,240}?(?:src/|src\\\\\\\\)?App\\.tsx"
    },
    {
      "id": "performance-adapter-no-runtime-injection",
      "sourceRegex": "^scripts/performance/(?!.*\\.(?:test|spec)\\.)[^\\r\\n]+\\.(?:js|mjs|cjs)$",
      "pattern": "\\b(?:addInitScript|addScriptTag|addStyleTag|setContent|exposeBinding|exposeFunction)\\s*\\(|\\bWorker\\s*\\.\\s*prototype\\b|\\b(?:skipWaiting|clientsClaim)\\s*\\(|\\bnavigator\\s*\\.\\s*serviceWorker\\s*\\.\\s*register\\s*\\(|\\.\\s*unregister\\s*\\(|\\bcaches\\s*\\.\\s*delete\\s*\\(|\\bURL\\s*\\.\\s*createObjectURL\\s*\\(|[\"'`]\\s*(?:blob|data):"
    },
    {
      "id": "performance-adapter-route-isolation",
      "sourceRegex": "^scripts/performance/(?!hashBoundWorkerFaults\\.mjs$)(?!.*\\.(?:test|spec)\\.)[^\\r\\n]+\\.(?:js|mjs|cjs)$",
      "pattern": "\\.\\s*(?:route|routeFromHAR)\\s*\\("
    },
    {
      "id": "performance-adapter-no-production-source-import",
      "sourceRegex": "^scripts/performance/(?!.*\\.(?:test|spec)\\.)[^\\r\\n]+\\.(?:js|mjs|cjs)$",
      "pattern": "(?:from\\s*|import\\s*\\(\\s*)[\"'](?:src(?:[\"']|/|\\\\)|[^\"']*(?:/|\\\\)src(?:[\"']|/|\\\\))"
    },
    {
      "id": "performance-adapter-no-target-harness-contract",
      "sourceRegex": "^scripts/performance/(?!.*\\.(?:test|spec)\\.)[^\\r\\n]+\\.(?:js|mjs|cjs)$",
      "pattern": "__ESP_CANONICAL_PERFORMANCE_HARNESS__|foundation-performance-scenario"
    }
  ],
  "forbiddenProductionPathRules": [
    {
      "id": "no-legacy-xlsx-facades",
      "pathRegex": "^src/utils/(?:exportImport|xlsxMapParser)\\.ts$"
    },
    {
      "id": "no-temporary-app-persistence-bridge",
      "pathRegex": "^src/(?:app|persistence)/.*(?:legacyIndexedDb|temporary(?:Persistence)?Bridge).*(?:\\.ts|\\.tsx)$"
    },
    {
      "id": "no-stale-bootstrap-entry",
      "pathRegex": "^src/bootstrap\\.ts$"
    }
  ],
  "baseline": "config/architecture-baseline.json",
  "exceptionPolicy": {
    "requiredFields": [
      "id",
      "ruleId",
      "source",
      "owner",
      "reason",
      "expiry",
      "fingerprint"
    ],
    "rejectExpired": true,
    "rejectNewViolations": true
  }
}
