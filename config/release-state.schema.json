                  "type": "null"
                },
                {
                  "$ref": "#/$defs/deploymentBinding"
                }
              ]
            }
          },
          "required": [
            "releaseRole",
            "binding",
            "activatedAt",
            "recoveryDeadline"
          ]
        }
      ]
