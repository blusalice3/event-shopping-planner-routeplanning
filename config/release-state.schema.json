{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-shopping-planner:release-state:v1",
  "title": "Release State v1",
  "$ref": "#/$defs/releaseEventEnvelope",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "immutableObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/(?:events/[1-9][0-9]*/|evidence/)[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["uri", "sha256"]
    },
    "dbCompatibilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contractUri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["contractUri", "fingerprint"]
    },
    "approvalReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "subjectSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trustedIssuer": {
          "const": "https://token.actions.githubusercontent.com"
        },
        "issuerReceiptUri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "issuerReceiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflowRunId": {
          "type": "string",
          "minLength": 1
        },
        "protectedEnvironment": {
          "type": "string",
          "minLength": 1
        },
        "providerReviewerId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["releaseOwner", "dataSafetyReviewer", "operationsReviewer"]
        },
        "decision": {
          "const": "APPROVED"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uri",
        "sha256",
        "approvalId",
        "operationId",
        "subjectSha256",
        "trustedIssuer",
        "issuerReceiptUri",
        "issuerReceiptSha256",
        "workflowRunId",
        "protectedEnvironment",
        "providerReviewerId",
        "role",
        "decision",
        "approvedAt"
      ]
    },
    "deploymentBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "$ref": "#/$defs/sourceSha"
        },
        "buildId": {
          "$ref": "#/$defs/sourceSha"
        },
        "variantId": {
          "$ref": "#/$defs/sha256"
        },
        "releaseRole": {
          "enum": ["standard", "containment"]
        },
        "publicIdentityKind": {
          "enum": ["release-identity-v1", "legacy-bootstrap-v1"]
        },
        "providerProjectId": {
          "type": "string",
          "minLength": 1
        },
        "providerDeploymentId": {
          "type": "string",
          "minLength": 1
        },
        "deploymentUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "artifactArchive": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "artifactArchiveAvailability": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "packageIndex": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "artifactManifest": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "providerEvidence": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "releasePolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "providerPolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "providerConfigurationHash": {
          "$ref": "#/$defs/sha256"
        },
        "requiredDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        }
      },
      "dependentRequired": {
        "artifactArchive": ["artifactArchiveAvailability"],
        "artifactArchiveAvailability": ["artifactArchive"]
      },
      "required": [
        "bindingId",
        "sourceSha",
        "buildId",
        "variantId",
        "releaseRole",
        "publicIdentityKind",
        "providerProjectId",
        "providerDeploymentId",
        "deploymentUrl",
        "artifactArchive",
        "artifactArchiveAvailability",
        "packageIndex",
        "artifactManifest",
        "providerEvidence",
        "releasePolicy",
        "providerPolicy",
        "providerConfigurationHash",
        "requiredDbCompatibility"
      ]
    },
    "pendingOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "promote-standard",
            "rollback-standard",
            "activate-containment",
            "redeploy-standard",
            "redeploy-containment"
          ]
        },
        "expectedState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "eventHash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": ["sequence", "eventHash"]
        },
        "targetBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "originBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        },
        "originCompanionBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        },
        "companionBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        },
        "previousBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        },
        "emergencyRecoveryBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "approvalRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approvalReference"
          }
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reconciliationAuthority": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reconciliationKind": {
              "enum": [
                "provider-target-assigned/v1",
                "provider-previous-assigned/v1",
                "provider-emergency-assigned/v1"
              ]
            },
            "providerObservation": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "stateReconciled": {
              "$ref": "#/$defs/immutableObjectRef"
            }
          },
          "required": [
            "reconciliationKind",
            "providerObservation",
            "stateReconciled"
          ]
        }
      },
      "required": [
        "operationId",
        "kind",
        "expectedState",
        "targetBinding",
        "originBinding",
        "originCompanionBinding",
        "companionBinding",
        "previousBinding",
        "emergencyRecoveryBinding",
        "approvalRefs",
        "preparedAt"
      ]
    },
    "pendingAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "standardBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "companionBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "assignmentValidationEvidence": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "observationStartedEvent": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "observationNotBefore": {
          "type": "string",
          "format": "date-time"
        },
        "minimumObservationEndsAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "operationId",
        "standardBinding",
        "companionBinding",
        "assignmentValidationEvidence",
        "observationStartedEvent",
        "observationNotBefore",
        "minimumObservationEndsAt"
      ]
    },
    "legacyProductionObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observationUri": {
          "type": "string",
          "pattern": "^release-state://[a-z0-9][a-z0-9-]{2,62}/evidence/[0-9a-f]{64}$"
        },
        "observationSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["observationUri", "observationSha256"]
    },
    "containmentIncident": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["legacy-bootstrap", "source-hardened"]
        },
        "binding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recoveryDeadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kind", "binding", "activatedAt", "recoveryDeadline"]
    },
    "standardRecovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containmentBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "targetStandard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        },
        "recoveryDeadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["containmentBinding", "targetStandard", "recoveryDeadline"]
    },
    "rollbackInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "acceptedEvent": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "acceptedGate": {
          "$ref": "#/$defs/phaseGate"
        },
        "acceptedStandardFloors": {
          "$ref": "#/$defs/floorMap"
        },
        "evaluatedPolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "eligibleActions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["package-redeploy", "rollback"]
          }
        },
        "eligibility": {
          "enum": ["eligible", "ineligible"]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      },
      "required": [
        "binding",
        "acceptedEvent",
        "acceptedGate",
        "acceptedStandardFloors",
        "evaluatedPolicy",
        "eligibleActions",
        "eligibility",
        "reasonCodes"
      ]
    },
    "rollbackInventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rollbackInventoryEntry"
      }
    },
    "policyCompatibilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "predecessorPolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "eligibleBindingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["containment", "rollback"]
          }
        },
        "minimumSafetyFloors": {
          "$ref": "#/$defs/floorMap"
        },
        "requiredDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "predecessorPolicy",
        "eligibleBindingIds",
        "allowedActions",
        "minimumSafetyFloors",
        "requiredDbCompatibility",
        "expiresAt",
        "owner"
      ]
    },
    "floorMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "phaseGate": {
      "enum": [
        "P0-RELEASE",
        "P1-PWA",
        "P2A-LOCAL",
        "P2B-REPORT",
        "P3-XLSX",
        "P4-CSP",
        "P5-DUAL",
        "P5-LIST",
        "P6-APP",
        "P7-IDB",
        "P8-CLEAN"
      ]
    },
    "stateInitializedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptedGate": {
          "type": "null"
        },
        "legacyObservedProduction": {
          "$ref": "#/$defs/legacyProductionObservation"
        },
        "bootstrapRecovery": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "minimumSafetyFloors": {
          "$ref": "#/$defs/floorMap"
        },
        "currentDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        },
        "activeReleasePolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        }
      },
      "required": [
        "acceptedGate",
        "legacyObservedProduction",
        "bootstrapRecovery",
        "minimumSafetyFloors",
        "currentDbCompatibility",
        "activeReleasePolicy"
      ]
    },
    "policyActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activationGate": {
          "enum": [
            "P1-PWA",
            "P2A-LOCAL",
            "P2B-REPORT",
            "P3-XLSX",
            "P4-CSP",
            "P5-DUAL",
            "P5-LIST",
            "P7-IDB",
            "P8-CLEAN"
          ]
        },
        "previousReleasePolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "proposedReleasePolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "activeReleasePolicy": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "behaviorDimensionChange": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "enum": [
                    "pwaLifecycle",
                    "cssDelivery",
                    "cspMode",
                    "xlsxExecution",
                    "listEngine",
                    "listDefault",
                    "persistenceArchitecture"
                  ]
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["dimension", "from", "to"]
            }
          ]
        },
        "minimumSafetyFloorChange": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "styleSrcAttr": {
                  "const": "none"
                }
              },
              "required": ["styleSrcAttr"]
            }
          ]
        },
        "minimumSafetyFloors": {
          "$ref": "#/$defs/floorMap"
        },
        "activePolicyCompatibility": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyCompatibilityEntry"
          }
        },
        "closureBundle": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "closureEvidenceRefs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/immutableObjectRef"
          }
        },
        "rollbackInventory": {
          "$ref": "#/$defs/rollbackInventory"
        }
      },
      "required": [
        "activationGate",
        "previousReleasePolicy",
        "proposedReleasePolicy",
        "activeReleasePolicy",
        "behaviorDimensionChange",
        "minimumSafetyFloorChange",
        "minimumSafetyFloors",
        "activePolicyCompatibility",
        "closureBundle",
        "closureEvidenceRefs",
        "rollbackInventory"
      ]
    },
    "dbContractActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        },
        "currentDbCompatibility": {
          "$ref": "#/$defs/dbCompatibilityBinding"
        },
        "rollbackInventory": {
          "$ref": "#/$defs/rollbackInventory"
        }
      },
      "required": [
        "previousDbCompatibility",
        "currentDbCompatibility",
        "rollbackInventory"
      ]
    },
    "promotionPreparedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pendingOperation": {
          "$ref": "#/$defs/pendingOperation"
        }
      },
      "required": ["pendingOperation"]
    },
    "deploymentAssignedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentReceipt": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "promotionReceipt": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "targetBinding": {
          "$ref": "#/$defs/deploymentBinding"
        }
      },
      "required": ["assignmentReceipt", "promotionReceipt", "targetBinding"]
    },
    "assignmentValidatedPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assignmentReceipt": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "assignmentValidation": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "productionProbe": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "targetBinding": {
              "$ref": "#/$defs/deploymentBinding"
            }
          },
          "required": [
            "assignmentReceipt",
            "assignmentValidation",
            "productionProbe",
            "targetBinding"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reconciliationKind": {
              "enum": [
                "provider-target-assigned/v1",
                "provider-previous-assigned/v1",
                "provider-emergency-assigned/v1"
              ]
            },
            "providerObservation": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "stateReconciled": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "targetBinding": {
              "$ref": "#/$defs/deploymentBinding"
            }
          },
          "required": [
            "reconciliationKind",
            "providerObservation",
            "stateReconciled",
            "targetBinding"
          ]
        }
      ]
    },
    "observationStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pendingAcceptance": {
          "$ref": "#/$defs/pendingAcceptance"
        }
      },
      "required": ["pendingAcceptance"]
    },
    "releaseAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptedGate": {
          "$ref": "#/$defs/phaseGate"
        },
        "releaseRole": {
          "const": "standard"
        },
        "observedThrough": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedStandardFloors": {
          "$ref": "#/$defs/floorMap"
        },
        "rollbackInventory": {
          "$ref": "#/$defs/rollbackInventory"
        },
        "clearBootstrapRecovery": {
          "type": "boolean"
        }
      },
      "required": [
        "acceptedGate",
        "releaseRole",
        "observedThrough",
        "acceptedStandardFloors",
        "rollbackInventory",
        "clearBootstrapRecovery"
      ]
    },
    "operationAbortedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "containmentActivationPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recoveryDeadline": {
          "type": "string",
          "format": "date-time"
        },
        "targetStandard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deploymentBinding"
            }
          ]
        }
      },
      "required": ["binding", "activatedAt", "recoveryDeadline"]
    },
    "rollbackActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "companionBinding": {
          "$ref": "#/$defs/deploymentBinding"
        },
        "originAcceptedEvent": {
          "$ref": "#/$defs/immutableObjectRef"
        },
        "originAcceptedGate": {
          "$ref": "#/$defs/phaseGate"
        },
        "originAcceptedStandardFloors": {
          "$ref": "#/$defs/floorMap"
        }
      },
      "required": [
        "binding",
        "companionBinding",
        "originAcceptedEvent",
        "originAcceptedGate",
        "originAcceptedStandardFloors"
      ]
    },
    "packageRedeployActivatedPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "releaseRole": {
              "const": "standard"
            },
            "standardBinding": {
              "$ref": "#/$defs/deploymentBinding"
            },
            "companionBinding": {
              "$ref": "#/$defs/deploymentBinding"
            },
            "rollbackInventory": {
              "$ref": "#/$defs/rollbackInventory"
            },
            "originAcceptedEvent": {
              "$ref": "#/$defs/immutableObjectRef"
            },
            "originAcceptedGate": {
              "$ref": "#/$defs/phaseGate"
            },
            "originAcceptedStandardFloors": {
              "$ref": "#/$defs/floorMap"
            }
          },
          "required": [
            "releaseRole",
            "standardBinding",
            "companionBinding",
            "rollbackInventory",
            "originAcceptedEvent",
            "originAcceptedGate",
            "originAcceptedStandardFloors"
          ]
        },
        {
